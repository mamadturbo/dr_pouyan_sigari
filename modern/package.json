{
  "name": "dr-sigari-modern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate.mjs && next build --webpack && node scripts/normalize-export.mjs && node scripts/check-export.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/story-player.test.cjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve.mjs",
    "measure": "node scripts/performance.mjs",
    "release": "node scripts/release.mjs",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.2",
    "gsap": "3.15.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
